---
import type { CollectionEntry } from 'astro:content';
import ImportanceBadge from './ImportanceBadge.astro';
import { CATEGORY_LABELS, formatDate, scoreTotal, url } from '../lib/veille';

interface Props {
  article: CollectionEntry<'articles'>;
  headingLevel?: 'h2' | 'h3';
}
const { article, headingLevel = 'h3' } = Astro.props;
const { data } = article;
const total = scoreTotal(data.score);
const Heading = headingLevel;
---

<article
  class={`card article-card imp-${data.importance}`}
  data-category={data.category}
  data-importance={data.importance}
  data-search={`${data.title} ${data.summary} ${data.tags.join(' ')} ${(data.cve ?? []).join(' ')}`.toLowerCase()}
>
  <div class="meta">
    <ImportanceBadge importance={data.importance} total={total} />
    <span class="cat">{CATEGORY_LABELS[data.category]}</span>
    {data.exemple && <span class="exemple">Exemple</span>}
  </div>
  <Heading class="title">
    <a href={url(`articles/${article.id}/`)}>{data.title}</a>
  </Heading>
  <p class="summary">{data.summary}</p>
  <p class="date muted"><time datetime={data.date.toISOString()}>{formatDate(data.date)}</time></p>
</article>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-left-width: 4px;
  }
  .imp-critique {
    border-left-color: var(--critique);
  }
  .imp-eleve {
    border-left-color: var(--eleve);
  }
  .imp-moyen {
    border-left-color: var(--moyen);
  }
  .imp-info {
    border-left-color: var(--info);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
  }
  .cat {
    color: var(--muted);
  }
  .exemple {
    font-size: 0.75rem;
    border: 1px dashed var(--border);
    color: var(--muted);
    padding: 0.05em 0.5em;
    border-radius: 999px;
  }
  .title {
    font-size: 1.1rem;
    margin: 0;
  }
  .title a {
    color: var(--text);
    text-decoration: none;
  }
  .title a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .summary {
    margin: 0;
    color: var(--muted);
    font-size: 0.97rem;
  }
  .date {
    margin: auto 0 0;
    font-size: 0.85rem;
  }
</style>
