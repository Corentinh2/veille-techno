---
import '../styles/global.css';
import { url } from '../lib/veille';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Veille technologique hebdomadaire : cybersécurité, infra/cloud/DevOps, IA, réseau et OS.' } =
  Astro.props;
const siteName = 'Veille Techno';
const fullTitle = title === siteName ? siteName : `${title} · ${siteName}`;

const nav = [
  { href: url(''), label: 'Accueil', match: (p: string) => p === url('') || p === url('') + '/' },
  { href: url('articles/'), label: 'Articles', match: (p: string) => p.startsWith(url('articles')) },
  { href: url('archives/'), label: 'Archives', match: (p: string) => p.startsWith(url('archives')) },
  { href: url('methodologie/'), label: 'Méthodologie', match: (p: string) => p.startsWith(url('methodologie')) },
  { href: url('sources/'), label: 'Sources', match: (p: string) => p.startsWith(url('sources')) },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      // Appliqué avant l'affichage pour éviter le « flash » de thème.
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="visually-hidden" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={url('')}>
          <span class="brand-mark" aria-hidden="true">◆</span> Veille Techno
        </a>
        <nav aria-label="Navigation principale">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.match(path) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <button class="theme-toggle" type="button" aria-label="Basculer le mode sombre" title="Mode clair / sombre">
          <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
          <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
            <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"></path>
            </g>
          </svg>
        </button>
      </div>
    </header>

    <main id="contenu" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          Veille réalisée dans le cadre de mon alternance en administration systèmes et réseaux. Articles rédigés
          avec mes propres mots, sources citées sous chaque article. ·
          <a href={url('methodologie/')}>Méthodologie</a>
        </p>
      </div>
    </footer>

    <script>
      const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
      btn?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 60px;
    flex-wrap: wrap;
    padding-top: 0.4rem;
    padding-bottom: 0.4rem;
  }

  .brand {
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    font-size: 1.1rem;
    white-space: nowrap;
  }

  .brand-mark {
    color: var(--accent);
  }

  nav {
    flex: 1;
    min-width: 0;
  }

  nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  nav a {
    display: block;
    padding: 0.35rem 0.65rem;
    border-radius: 6px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }

  nav a:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  nav a[aria-current='page'] {
    color: var(--accent);
    background: var(--accent-soft);
    font-weight: 600;
  }

  .theme-toggle {
    margin-left: auto;
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }

  .theme-toggle:hover {
    background: var(--surface-2);
  }

  :global([data-theme='dark']) .icon-moon,
  :global([data-theme='light']) .icon-sun {
    display: none;
  }

  @media (max-width: 640px) {
    nav {
      order: 3;
      flex-basis: 100%;
      overflow-x: auto;
    }
    nav ul {
      flex-wrap: nowrap;
    }
  }

  main {
    padding-top: 2rem;
    padding-bottom: 3rem;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
    padding: 1.25rem 0;
  }

  .site-footer p {
    margin: 0;
  }
</style>
